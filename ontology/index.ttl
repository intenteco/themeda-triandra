@prefix q42:    <urn:qualia:ontology:> .
@prefix qualia: <urn:qualia:taxon:> .
@prefix member: <urn:qualia:member:themeda-triandra:> .

qualia:themeda_triandra a dcat:Dataset ;
    owl:sameAs <did:q42:taxon:themeda_triandra> ;
    dct:title "Themeda triandra Forssk. (Kangaroo Grass) Hypermedia Dataset"@en ;
